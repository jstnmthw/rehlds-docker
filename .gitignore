# =============================================================================
#  .gitignore — ReHLDS Counter-Strike 1.6 server
# =============================================================================
#  Tracked: Dockerfile, the docker-compose*.example.yml templates, scripts/,
#  config/, docs and .env.example. Ignored: secrets, the active
#  docker-compose.yml, runtime server data, editor/OS noise.

# --- Secrets / local config --------------------------------------------------
# Real env files (RCON passwords, server names) are copied from the *.env.example
# templates and edited locally. The templates ARE tracked; the real env files are
# not — this covers .env and per-server fleet files like cstrike-01.env. The
# `*.env` glob does not match `*.env.example`, so the templates stay tracked; the
# explicit negation makes that intent unmistakable.
*.env
!*.env.example
.env.local
.env.*.local

# --- Active Compose file -----------------------------------------------------
# docker-compose.yml is the file `docker compose` reads by default. It is NOT
# tracked — pick a topology and copy a template into place:
#   cp docker-compose.example.yml docker-compose.yml        # single server
#   cp docker-compose.fleet.example.yml docker-compose.yml  # fleet
# The docker-compose*.example.yml templates ARE tracked; your working copy is not.
docker-compose.yml

# --- Host-specific Compose overrides -----------------------------------------
# docker-compose.override.yml is auto-merged by Compose; it and the fastdl/
# nginx config are host-specific and copied to the prod box by hand — never
# tracked, so the committed compose templates stay network-agnostic.
docker-compose.override.yml
fastdl/

# --- Runtime server data -----------------------------------------------------
# The serverfiles volumes (./serverdata/<name>, e.g. ./serverdata/default): the
# whole CS 1.6 install plus maps, logs, bans and the generated Reunion salt —
# many GB, constantly mutated, and fully regenerable from the image. Source
# config lives in config/ instead. Mirrors the .dockerignore exclusions.
serverdata/
data/
*-data/

# --- Python (scripts/clear-execstack.py) -------------------------------------
__pycache__/
*.py[cod]

# --- Editors / IDEs ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS cruft ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Misc --------------------------------------------------------------------
*.log
*.bak
*.orig
