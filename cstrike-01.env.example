# =============================================================================
#  Fleet server #1 — runtime config   (cstrike-01)
# =============================================================================
#  One env file per server. Copy it to a real env file and edit:
#     cp cstrike-01.env.example cstrike-01.env
#  docker-compose.fleet.example.yml wires each service to its own env file and
#  its own ./serverdata/<name> volume.
#
#  This file holds RUNTIME config only — everything the entrypoint reads. The
#  container name and the volume path are NOT here: they are topology, hardcoded
#  per service in the compose file. Every value below is applied at container
#  start (docker compose up -d), no rebuild needed.
#
#  Only the most common per-server settings are shown. Any variable documented
#  in .env.example (SV_*, fast downloads, remote logging, Reunion, engine flags)
#  can be added here verbatim.
# =============================================================================

# --- Networking — MUST be unique per co-resident server ----------------------
# With network_mode: host every server binds its ports directly on the host, so
# each server needs its own pair. Port-forward SERVER_PORT to expose it.
SERVER_PORT=27015
CLIENT_PORT=27005

# --- Identity ----------------------------------------------------------------
SERVER_NAME=ReHLDS CS 1.6 — #1
# SET THIS (empty disables RCON). Use a distinct password per server.
RCON_PASSWORD=
# Join password; empty = public.
SERVER_PASSWORD=

# --- Owner / admin -----------------------------------------------------------
# SteamID bootstrapped as a full AMX Mod X admin. See .env.example for details.
OWNER=

# --- Master server / listing -------------------------------------------------
SV_LAN=0
SV_REGION=255

# --- Gameplay ----------------------------------------------------------------
MAX_PLAYERS=16
DEFAULT_MAP=de_dust2

# --- Plugin gates ------------------------------------------------------------
# BOTS_ENABLED only gates whether YaPB loads; bot count/difficulty are YaPB
# defaults, tuned per-server by editing the volume's addons/yapb/conf/yapb.cfg.
BOTS_ENABLED=true
REUNION_ENABLED=false
