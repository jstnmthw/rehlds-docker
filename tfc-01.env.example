# =============================================================================
#  Team Fortress Classic server — runtime config   (tfc-01)
# =============================================================================
#  One env file per server. Copy it to a real env file and edit:
#     cp tfc-01.env.example tfc-01.env
#  docker-compose.bridge.example.yml wires the tfc-01 service to this file, the
#  rehlds-tfc:local image and its own ./serverdata/tfc-01 volume.
#
#  This file holds RUNTIME config only — everything the entrypoint reads. The
#  KEYS are the same for every game in the image family; only the defaults
#  differ (map, slots, start parameters). Every value is applied at container
#  start (docker compose up -d <name>), no rebuild needed. Any variable
#  documented in .env.example (SV_*, fast downloads, remote logging, Reunion,
#  log retention) can be added here verbatim.
# =============================================================================

# --- Networking --------------------------------------------------------------
# On the bridge topology the published port in the compose file must equal
# SERVER_PORT; on host networking every co-resident server needs its own pair.
# Port-forward SERVER_PORT to expose it. Template port map: tfc-01 27015,
# cstrike-01/02/03 27016-27018, dod-01 27019.
SERVER_PORT=27015
CLIENT_PORT=27005

# --- Identity ----------------------------------------------------------------
SERVER_NAME='ReHLDS Team Fortress Classic'
# SET THIS (empty disables RCON). Use a distinct password per server.
RCON_PASSWORD=
# Join password; empty = public.
SERVER_PASSWORD=

# --- Owner / admin -----------------------------------------------------------
# SteamID bootstrapped as a full AMX Mod X admin. See .env.example for details.
OWNER=

# --- Master server / listing -------------------------------------------------
SV_LAN=0
SV_REGION=255

# --- Gameplay ----------------------------------------------------------------
# Image defaults for TFC: 32 slots, map "well". (Empty = the image default.)
MAX_PLAYERS=32
DEFAULT_MAP=well

# --- Log retention (in-volume tfc/logs/ and addons/amxmodx/logs/) ------------
LOG_RETENTION_DAYS=14

# --- Plugin gates ------------------------------------------------------------
# BOTS_ENABLED only gates whether FoxBot loads. Bot count (max_bots, stock 10),
# skill and chat are FoxBot's own config, tuned per-server by editing the
# volume's tfc/addons/foxbot/tfc/foxbot.cfg (seeded once, never overwritten;
# applies on the next map change or restart).
BOTS_ENABLED=true
REUNION_ENABLED=false

# --- Engine / performance ----------------------------------------------------
# Extra HLDS launch parameters. The TFC image defaults to NONE (engine
# defaults); set e.g. "-pingboost 1 +sys_ticrate 1000" once measurement says
# the server wants it. An empty value means the image default.
EXTRA_START_PARAMS=
