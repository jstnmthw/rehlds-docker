# Keep the build context small and free of secrets / runtime state.
# The build needs Dockerfile + scripts/ + config/ + profiles/ + vendor/.

# Secrets and local config
.env
.env.*
*.env
*.env.example

# Compose files are not part of the image (docker-compose.yml is the operator's)
docker-compose*.yml
fastdl/

# Runtime data (serverfiles, logs, runtime state) — can be many GB
serverdata/
data/
*-data/

# Version control
.git
.gitignore
.gitattributes

# Documentation — not needed inside the image
*.md
START.md
docs/

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
__pycache__/
